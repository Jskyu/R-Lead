# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-in-production-min-32-chars-required-for-security
PORT=8080

# Database
DATABASE_URL=jdbc:sqlite:rlead.db
DATABASE_DRIVER=org.sqlite.JDBC
DATABASE_USER=
DATABASE_PASSWORD=

# Frontend
FRONTEND_URL=http://localhost:5173

# S3 Storage (MinIO for local development)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=business-cards
S3_REGION=us-east-1
IMAGE_RETENTION_DAYS=90

# AI Provider (choose one: openai, gemini, claude, mock)
AI_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
# Gemini 모델 (Spring AI OpenAI 호환 엔드포인트로 호출). 과부하(503) 시 다른 모델로 교체
GEMINI_MODEL=gemini-3-flash-preview
CLAUDE_API_KEY=

# CRM (choose one: none, hubspot, salesforce)
CRM_TYPE=none
CRM_API_KEY=
CRM_API_URL=

# Email (Phase 2)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@example.com

# Authentication (choose one: google, microsoft)
AUTH_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
