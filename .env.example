# R-Lead 환경 변수 예시 (프로젝트 루트: docker compose 가 읽는 값 + FastAPI 설정 참고용)
#   - docker compose: AI_PROVIDER, *_API_KEY, GEMINI_MODEL, SECRET_KEY, CRM_TYPE, S3_PUBLIC_ENDPOINT 만 사용합니다.
#   - FastAPI 를 직접 실행할 때는 backend/.env.example 을 backend/.env 로 복사하세요.
#   - Spring Boot 를 직접 실행할 때는 backend-spring/.env.example 을 backend-spring/.env 로 복사하세요.
# (.env 는 비밀값을 담으므로 커밋하지 않습니다)

# Backend Configuration
ENVIRONMENT=development
DEBUG=true
# SQL 로그(바인딩 값에 개인정보가 출력됨). 개발 중 필요할 때만 true
SQL_ECHO=false
SECRET_KEY=change-this-to-a-random-secret-key

# Database (PostgreSQL)
# FIXME: 프로덕션에서는 PostgreSQL 사용, 개발 초기는 SQLite 가능
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rlead
# DATABASE_URL=sqlite+aiosqlite:///./rlead.db

# S3 Storage (MinIO for development)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=business-cards
S3_REGION=us-east-1
# 브라우저가 명함 사진을 여는 주소 (Docker 에서는 내부 주소 minio 와 달라서 필요). 비우면 S3_ENDPOINT 사용
S3_PUBLIC_ENDPOINT=http://localhost:9000
IMAGE_RETENTION_DAYS=90

# AI Model Configuration
# FIXME: OpenAI, Gemini, Claude 중 선택
AI_PROVIDER=gemini  # openai | gemini | claude
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
# Gemini 모델. 과부하(503)/할당량(429) 시 다른 모델로 교체 (기본 gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest
CLAUDE_API_KEY=...

# CRM Configuration
# FIXME: CRM 종류 결정 후 설정
CRM_TYPE=none  # none | hubspot | salesforce
CRM_API_KEY=...
CRM_API_URL=...

# Email Configuration (2단계)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASSWORD=...
FROM_EMAIL=noreply@example.com

# Authentication
# FIXME: Google Workspace 또는 Microsoft 계정 연동
AUTH_PROVIDER=google  # google | microsoft
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
MICROSOFT_CLIENT_ID=...
MICROSOFT_TENANT_ID=...

# Frontend URL
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
